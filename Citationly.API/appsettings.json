{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=opus_db;Username=postgres;Password=postgres"
  },
  "Firebase": {
    "ProjectId": "aeo-agent-581db"
  },
  "Admin": {
    "JwtSigningKey": "citationly_jwt_signing_key_default_secret_32bytes_long!",
    "JwtIssuer": "Citationly.Admin",
    "JwtAudience": "Citationly.Admin.Panel",
    "Username": "admin"
  },
  "OpenAI": {
    "ApiKey": "${OPENAI_API_KEY}",
    "Model": "gpt-4o-mini",
    "ChatModel": "gpt-4o",
    "ClassificationModel": "gpt-4o-mini",
    "SearchModel": "gpt-5-search-api",
    "EmbeddingModel": "text-embedding-3-small",
    "ObservationSamples": 5,
    "MaxTokens": 4096,
    "SearchMaxTokens": 4096,
    "EnableWebSearch": true
  },
  "Exa": {
    "ApiKey": "${EXA_API_KEY}",
    "Enabled": true,
    "BaseUrl": "https://api.exa.ai",
    "SearchType": "fast",
    "ResultsPerQuery": 5,
    "MaxHighlightCharacters": 2000,
    "CacheHours": 6,
    "ReservedCostPerSearchUsd": 0.012,
    "MonthlyBudgetUsd": 10.0
  },
  "Integrations": {
    "EncryptionKey": "${INTEGRATION_ENCRYPTION_KEY}"
  },
  "AI": {
    "EmergencyDisable": false
  },
  "Anthropic": {
    "ApiKey": "${ANTHROPIC_API_KEY}",
    "Model": "claude-3-5-haiku-latest"
  },
  "Google": {
    "ApiKey": "${GOOGLE_AI_API_KEY}",
    "Model": "gemini-2.0-flash",
    "EnableSearchGrounding": false
  },
  "Perplexity": {
    "ApiKey": "${PERPLEXITY_API_KEY}",
    "Model": "sonar"
  },
  "Stripe": {
    "ApiKey": "${STRIPE_API_KEY}",
    "WebhookSecret": "${STRIPE_WEBHOOK_SECRET}",
    "PriceIds": {
      "Starter": "${STRIPE_PRICE_ID_STARTER}",
      "Pro": "${STRIPE_PRICE_ID_PRO}",
      "Enterprise": "${STRIPE_PRICE_ID_ENTERPRISE}"
    }
  },
  "Billing": {
    "RequireCashfree": false,
    "AllowedRedirectOrigins": [
      "http://localhost:3000"
    ]
  },
  "Cashfree": {
    "Environment": "Sandbox",
    "AppId": "${CASHFREE_APP_ID}",
    "SecretKey": "${CASHFREE_SECRET_KEY}",
    "ApiVersion": "2025-01-01",
    "Plans": {
      "Starter": { "PlanId": "${CASHFREE_PLAN_ID_STARTER}" },
      "Pro": { "PlanId": "${CASHFREE_PLAN_ID_PRO}" },
      "Enterprise": { "PlanId": "${CASHFREE_PLAN_ID_ENTERPRISE}" }
    }
  }
}
